# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

ANTHROPIC_API_KEY=sk-...
# Set to "true" to skip real Anthropic API calls and use canned placeholder
# text instead — lets you build/test everything else at zero cost. Set to
# "false" (or remove) once you're ready to generate real articles.
ANTHROPIC_MOCK_MODE=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=...
# Required for schema/migration scripts and server-side writes that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=...

# Where scheduled articles get POSTed on publish (Phase 7)
WEBSITE_WEBHOOK_URL=https://atlasnetwork.club/api/webhook/publish-article
# Sent as `Authorization: Bearer <value>` on that POST — your website's
# webhook route must check for this same value, otherwise anyone who
# finds the URL could POST fake articles to your site.
WEBSITE_WEBHOOK_SECRET=...
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` —
# set the same value in your Vercel project's env vars once deployed.
# Leave blank locally to skip the check.
CRON_SECRET=...

# This app's own deployed URL, used for OAuth redirect URIs on the
# Uploads page (e.g. https://stat-atlas.vercel.app). NOT the same as
# utils/site.ts's SITE_URL, which points at atlasnetwork.club (the ATLAS
# Website) — see CLAUDE.md's "Uploads" / "LinkedIn" sections for full
# YouTube/TikTok/LinkedIn developer-portal setup steps.
APP_URL=http://localhost:3000

# Google Cloud OAuth client (YouTube Data API v3, "youtube.upload" scope)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...

# TikTok for Developers app (Content Posting API)
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# LinkedIn Developer Portal app ("Sign In with LinkedIn using OpenID
# Connect" + "Share on LinkedIn" products)
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
